<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de respaldo / transferencia para Android 12+ (API >= 31).
   Las fotos privadas de la app (files/fotos/) NO salen del teléfono.
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="fotos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="fotos/" />
    </device-transfer>
</data-extraction-rules>
